{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "jsx": "react-jsx", "strict": true,
    "allowJs": true, "checkJs": false, "noEmit": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["*.tsx", "*.ts", "*.mjs"]
}
