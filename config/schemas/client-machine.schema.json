{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awh:config:client-machine:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "endpoint",
    "home",
    "project_roots",
    "client_entry",
    "client_entry_sha256",
    "executor_type"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "home": {
      "type": "string",
      "minLength": 1
    },
    "project_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "client_entry": {
      "type": "string",
      "minLength": 1
    },
    "client_entry_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executor_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "ca_certificate_file": {
      "type": "string",
      "minLength": 1
    },
    "policy_trust_file": {
      "type": "string",
      "minLength": 1
    }
  }
}
