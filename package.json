{
  "name": "agent-workflow-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p dashboard/tsconfig.json && tsc -p dashboard-v2/tsconfig.json",
    "build": "node scripts/clean-build.mjs && tsc && node scripts/dashboard-build.mjs",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "handoff:check": "node dist/cli.js",
    "builder": "node dist/builder-cli.js",
    "admin": "node dist/admin-cli.js",
    "control-plane": "node dist/control-plane-cli.js",
    "client": "node dist/client/cli.js",
    "client:pack": "pnpm build && node scripts/client-pack.mjs",
    "viewer": "node dist/dashboard-cli.js",
    "viewer:pack": "pnpm build && node scripts/client-pack.mjs --viewer",
    "ui:pack": "pnpm build && node scripts/ui-pack.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:validate": "node scripts/release-validate.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "dashboard:fixture": "node scripts/dashboard-fixture.mjs",
    "dashboard:smoke": "node scripts/dashboard-smoke.mjs",
    "windows:smoke": "node scripts/windows-product-smoke.mjs",
    "dashboard:load": "node scripts/dashboard-load.mjs",
    "dashboard:v2:build": "node scripts/dashboard-v2-build.mjs",
    "dashboard:v2:preview": "node scripts/dashboard-v2-preview.mjs",
    "dashboard:v2:smoke": "node scripts/dashboard-v2-smoke.mjs",
    "dashboard:v2:viewer-smoke": "node scripts/dashboard-v2-viewer-smoke.mjs",
    "dashboard:v2:app-smoke": "node scripts/dashboard-v2-app-smoke.mjs",
    "test:self-bootstrap:local-fast": "node --test --test-name-pattern=\"^(?!.*(?:one binding drives three|same-account COMMENTED Review drives three|merged candidate needs|native failing or pending checks|interrupted creation)).*$\" tests/local-fast.test.mjs",
    "test:self-bootstrap:github-app": "node --test --test-name-pattern=\"^(?!.*(?:App Watcher|App Review Bridge)).*$\" tests/github-app.test.mjs"
  },
  "devDependencies": {
    "@radix-ui/themes": "3.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.55.0",
    "playwright": "1.62.1",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
